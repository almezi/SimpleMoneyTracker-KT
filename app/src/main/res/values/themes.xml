        <item name="colorPrimary">@color/saku_violet</item>
        <item name="colorPrimaryVariant">@color/saku_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/saku_violet</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/saku_bg</item>
        <item name="android:navigationBarColor">@color/saku_bg</item>
        <item name="android:windowBackground">@color/saku_bg</item>
    </style>
</resources>