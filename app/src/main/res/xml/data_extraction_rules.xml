<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ counterpart of backup_rules.xml: the database and preferences are
  excluded from cloud backup AND device-to-device transfer, so financial data
  never leaves the device by any system channel. Saku's own JSON export
  (Cadangan) is the supported migration path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
