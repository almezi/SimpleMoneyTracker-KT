<?xml version="1.0" encoding="utf-8"?>
<!--
  Saku is local-only by design: the Room database and the preferences never
  leave the device through Android Auto Backup. The app's own export
  (Cadangan → JSON) is the supported backup path, exactly as the Cadangan
  screen's own warning says ("Hapus aplikasi atau ganti perangkat tanpa
  cadangan, dan data hilang permanen").

  This file backs API < 31; data_extraction_rules.xml covers API 31+.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
